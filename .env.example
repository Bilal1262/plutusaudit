# ── Required: provider API keys ───────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
FEATHERLESS_API_KEY=your_featherless_api_key_here

# ── Database ──────────────────────────────────────────────────────────────────
# Docker-compose users: leave the password and DATABASE_URL will be auto-set by the api service.
PG_PASS=password
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/veridian

# ── Models (override only if you want to test other model IDs) ────────────────
GEMINI_MODEL=gemini-2.5-flash
FEATHERLESS_MODEL=Qwen/Qwen3-32B
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# ── Environment ───────────────────────────────────────────────────────────────
# Set to 'production' to disable the /_demo/tamper endpoint
ENVIRONMENT=development
